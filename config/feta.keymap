#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp ESC     &kp N1    &kp N2  &kp N3  &kp N4  &kp N5             &kp N6  &kp N7  &kp N8  &kp N9     &kp N0   &kp BSPC
&kp TAB     &kp Q     &kp W   &kp E   &kp R   &kp T              &kp Y   &kp U   &kp I   &kp O      &kp P    &kp ENTER
&kp LSHIFT  &kp A     &kp S   &kp D   &kp F   &kp G              &kp H   &kp J   &kp K   &kp L      &mo 1
&kp LCTRL   &kp LALT  &kp Z   &kp X   &kp C   &kp V              &kp B   &kp N   &kp M   &kp COMMA  &kp DOT  &kp FSLH
                                                      &kp SPACE
            >;
        };

        layer_1 {
            bindings = <
&kp F1            &kp F2        &kp F3  &kp F4     &kp F5     &kp F6                &kp F7    &kp F8    &kp F9    &kp F10       &kp F11    &kp F12
&kp TAB           &trans        &trans  &trans     &trans     &kp GRAVE             &trans    &trans    &trans    &trans        &trans     &kp ENTER
&kp LEFT_SHIFT    &trans        &trans  &kp EQUAL  &kp MINUS  &kp LBKT              &kp RBKT  &kp APOS  &kp FSLH  &kp UP_ARROW  &trans
&kp LEFT_CONTROL  &kp LEFT_ALT  &trans  &trans     &trans     &trans                &trans    &trans    &kp LEFT  &kp DOWN      &kp RIGHT  &trans
                                                                         &kp SPACE
            >;
        };
    };

    mo_layer: behavior_momentary_layer {
        compatible = "zmk,behavior-momentary-layer";

        lower_layer {
            display-name = "Lower";
            bindings = <
                &kp F1 &kp F2 &kp F3 &kp F4    &kp F5    &kp F6    &kp F7   &kp F8   &kp F9     &kp F10   &kp F11   &kp F12
                &trans &trans &trans &trans    &trans    &kp GRAVE &kp SEMI &trans   &trans     &trans    &trans    &trans 
                &trans &trans &trans &kp EQUAL &kp MINUS &kp LBKT  &kp RBKT &kp APOS &kp FSLASH &kp UP    &trans 
                &trans &trans &trans &trans    &trans    &trans    &trans   &trans   &kp LEFT   &kp DOWN  &kp RIGHT &trans 
                &trans
            >;
        };
    };
};

//        |esc| 1!| 2@| 3#| 4$| 5%|   | 6^| 7&| 8*| 9(| 0)|bac|
//        |tab| q | w | e | r | t |   | y | u | i | o | p |ent|
//        |ift| a | s | d | f | g |   | h | j | k | l |MoL|-er|
//        |con|alt| z | x | c | v |   | b | n | m |,< |.> |/? |
//                            |   space   |
//                        lower layer (Mol)
//      |f1 |f2 |f3 |f4 |f5 |f6 |      |f7 |f8 |f9 |f10|f11|f12|
//      |   |   |   |   |   | `~|      | ;:|   |   |   |   |   |
//      |   |   |   | =+| -_| {[|      | ]}| '"| \|| ^ | X |   |
//      |   |   |   |   |   |   |      |   |   | < | v | > |   |
//                            |   space   |
